# Terraform working directory
.terraform/

# Terraform state files
*.tfstate
*.tfstate.*

# Terraform variable files
*.tfvars
*.tfvars.json
!terraform.tfvars.example

# Terraform plan files
*.tfplan

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform CLI configuration
.terraformrc
terraform.rc

# Crash log files
crash.log
crash.*.log

# Sensitive / private keys
*.pem
*_rsa
*.key
